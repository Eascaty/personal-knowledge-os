#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(dirname -- "${SCRIPT_DIR}")

if ! command -v mvn >/dev/null 2>&1; then
    echo "未找到 Maven；请先安装 Maven 3.6.3 或更高版本。" >&2
    exit 1
fi

cd "${PROJECT_ROOT}"
exec mvn --batch-mode --file knowledge-service-java/pom.xml verify
