#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(dirname -- "${SCRIPT_DIR}")
IMPORT_PROJECT_ROOT=${KNOWLEDGE_IMPORT_PROJECT_ROOT:-${PROJECT_ROOT}}
IMPORT_DATABASE=${KNOWLEDGE_DB_PATH:-${IMPORT_PROJECT_ROOT}/workspace/data/state/knowledge.sqlite3}
IMPORT_RAW_ROOT=${KNOWLEDGE_RAW_ROOT:-${IMPORT_PROJECT_ROOT}/workspace/data/raw}

if [ "$#" -eq 0 ]; then
  echo "用法：./scripts/java-import <文件> [更多文件...]" >&2
  exit 2
fi

"${SCRIPT_DIR}/check-java21"
cd "${PROJECT_ROOT}/apps/api"
./mvnw --batch-mode -q -DskipTests clean package

JAR_PATH=$(find "${PROJECT_ROOT}/apps/api/target" -maxdepth 1 -type f \
  -name 'personal-knowledge-service-*.jar' ! -name '*.jar.original' -print)
case "${JAR_PATH}" in
  ''|*"
"*)
    echo "错误：无法唯一确定 Java 导入 JAR。" >&2
    exit 1
    ;;
esac
exec java \
  -Dloader.main=io.github.eascaty.knowledge.importer.KnowledgeImportCommand \
  -cp "${JAR_PATH}" \
  org.springframework.boot.loader.launch.PropertiesLauncher \
  --project-root "${IMPORT_PROJECT_ROOT}" \
  --database "${IMPORT_DATABASE}" \
  --raw-root "${IMPORT_RAW_ROOT}" \
  "$@"
