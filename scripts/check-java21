#!/bin/sh
set -eu

if ! command -v java >/dev/null 2>&1; then
  echo "错误：未找到 Java。apps/api 需要 JDK 21 或更高版本。" >&2
  exit 1
fi

JAVA_VERSION=$(java -version 2>&1 | sed -n '1s/.*version "\([^"]*\)".*/\1/p')
case "${JAVA_VERSION}" in
  1.*) JAVA_MAJOR=$(printf '%s' "${JAVA_VERSION}" | cut -d. -f2) ;;
  *) JAVA_MAJOR=$(printf '%s' "${JAVA_VERSION}" | cut -d. -f1) ;;
esac

case "${JAVA_MAJOR}" in
  ''|*[!0-9]*)
    echo "错误：无法识别 Java 版本：${JAVA_VERSION:-unknown}" >&2
    exit 1
    ;;
esac

if [ "${JAVA_MAJOR}" -lt 21 ]; then
  echo "错误：当前 Java ${JAVA_VERSION}，apps/api 需要 JDK 21 或更高版本。" >&2
  echo "请切换 JAVA_HOME 后重试；Python 流水线不依赖 Java。" >&2
  exit 1
fi
